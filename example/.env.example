# Parameters for dummy source (database configuration)
DATABASE_USERNAME=example_user
DATABASE_PASSWORD=change_me
DATABASE_ORG=example_org
DATABASE_BUCKET=example_bucket
DATABASE_TOKEN=change_me

# Parameters for dummy source (generator configuration)
INTERVAL_SECONDS=1
JITTER_MILLISECONDS=300
HISTORY_MINUTES=2
PERIOD_SECONDS=60
DROP_PROBABILITY=0.2

# Redis configuration
REDIS_PASSWORD=change_me

# Data crawler configuration
DATABASE_URL=http://dummy-source:8086
CRAWLER_LAG_TIME_SECONDS=1
POLLING_INTERVAL_SECONDS=5

# Regularizer: wait for the crawler to fill history before bootstrapping
BOOTSTRAP_DELAY_SECONDS=5
REGULARIZER_LAG_TIME_SECONDS=5

# Postges (TimescaleDB):
# admin user and password (plaintext)
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change_me
# data source user and password (plaintext)
POSTGRES_DATA_SOURCE_USER=data_source_user
POSTGRES_DATA_SOURCE_PASSWORD=change_me
# internal visualization user and password (plaintext)
POSTGRES_DATA_VIS_USER=vis_user
POSTGRES_DATA_VIS_PASSWORD=change_me
# public visualization user and password (plaintext)
POSTGRES_DATA_PUB_VIS_USER=pub_vis_user
POSTGRES_DATA_PUB_VIS_PASSWORD=change_me

# Grafana dashboard admin user and password (plaintext)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
