          "hide": false,
          "rawQuery": true,
          "rawSql": "SELECT\r\n  v.valid_time AS \"time\",\r\n  v.value AS \"measured (snap to grid)\"\r\nFROM unitemporal_double_details AS v\r\nJOIN unitemporal_jsonb_details AS q\r\n  ON q.valid_time = v.valid_time\r\n AND q.location_code = v.location_code\r\n AND q.data_provider = v.data_provider\r\n AND q.name = v.name || '_quality'\r\nWHERE v.name = 'sensor_1'\r\n  AND v.location_code = 'location_1'\r\n  AND v.data_provider = 'Example-Regularize'\r\n  AND q.value->>'quality' = 'measured'\r\n  AND $__timeFilter(v.valid_time)\r\nORDER BY 1",
